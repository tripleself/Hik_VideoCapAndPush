  },
  "rtsp_streaming": {
    "resolution": {
      "width": 640,
      "height": 360,
      "note": "RTSP推流分辨率，如果设置为0则使用原始分辨率"
    },
    "fps": 25,
    "note": "RTSP推流帧率"
